rules_version = '2';

// =============================================================================
// Firestore Security Rules - ThoughtFlow / mind-space
// =============================================================================
// These rules replace the expired 30-day "test mode" ruleset. Test mode grants
// open access via `if request.time < <date>` and silently begins denying every
// read and write once that date passes, surfacing as:
//     FirebaseError: Missing or insufficient permissions.
//
// SECURITY POSTURE - READ THIS:
// The app currently uses NO Firebase Auth (no getAuth / signInAnonymously
// anywhere in src/), so every request arrives unauthenticated and
// `request.auth` is always null. Rules requiring `request.auth != null` would
// therefore block the entire app.
//
// So these rules allow unauthenticated access, BUT they are scoped to the exact
// document paths the app actually uses. Everything else is denied by default.
// That prevents an attacker from writing arbitrary collections into your
// database (using it as free storage) even though your known paths are open.
//
// This is a DEVELOPMENT posture. Anyone who reads your JS bundle can find the
// project ID and read/modify/delete all data under these paths. Before storing
// anything sensitive, switch to the authenticated ruleset at the bottom.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // userMeta/main -> { activeProjectId, defaultProjectId }
    // Referenced in persistenceService.js: doc(db, 'userMeta', 'main')
    // -------------------------------------------------------------------------
    match /userMeta/{docId} {
      allow read, write: if true;
    }

    // -------------------------------------------------------------------------
    // projects/{projectId} -> project metadata document
    // `read` covers both `get` (single project) and `list`, which is required
    // because loadAllProjectsFromFirestore() calls getDocs(collection(db,
    // 'projects')) to enumerate the collection.
    // -------------------------------------------------------------------------
    match /projects/{projectId} {
      allow read, write: if true;

      // projects/{projectId}/workspaces/{workspaceId} -> nodes, edges, groups,
      // pins, images. One document per workspace.
      match /workspaces/{workspaceId} {
        allow read, write: if true;
      }

      // projects/{projectId}/tasks/taskData -> { tasks, taskGroups }
      match /tasks/{taskDoc} {
        allow read, write: if true;
      }

      // projects/{projectId}/snapshots/{stamp} -> version history snapshots
      match /snapshots/{snapshotId} {
        allow read, write: if true;
      }
    }

    // Any path not matched above is denied by default. Do not add a
    // match /{document=**} catch-all here - that would defeat the scoping.
  }
}

// =============================================================================
// FUTURE: authenticated ruleset
// =============================================================================
// Once Anonymous Auth (or a real sign-in method) is wired up, replace each
// `if true` above with `if request.auth != null`. Note that anonymous auth
// still lets ANY visitor obtain a token, so it is a modest improvement, not
// real protection. Proper isolation requires an ownerUid field on each project
// document and rules of the form:
//
//   match /projects/{projectId} {
//     allow read, write: if request.auth != null
//                        && resource.data.ownerUid == request.auth.uid;
//   }
//
// That requires a data migration to stamp ownerUid onto existing documents,
// and subcollection rules must use get() to look up the parent's ownerUid:
//
//   allow read, write: if request.auth != null
//     && get(/databases/$(database)/documents/projects/$(projectId))
//          .data.ownerUid == request.auth.uid;
// =============================================================================
